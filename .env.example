# ChupaCabra — copie para .env e personalize antes de iniciar.
# Nunca comite .env, backups, certificados ou credenciais reais.
APP_ENV=production
TZ=America/Sao_Paulo

# Para instalação LOCAL com compose.standalone.yaml, use HTTP apenas em 127.0.0.1.
LOCAL_PORT=8080
COOKIE_SECURE=0
SESSION_LIFETIME_DAYS=30
SESSION_RENEW_ON_ACTIVITY=1
# Gerar com: docker compose -f compose.standalone.yaml run --rm --no-deps api php bin/create-users.php usuario
AUTH_USERS_B64=

DB_NAME=chupacabra
DB_USER=chupacabra
DB_PASSWORD=SUBSTITUA_POR_UMA_SENHA_FORTE
DB_ROOT_PASSWORD=SUBSTITUA_POR_OUTRA_SENHA_FORTE
REDIS_PASSWORD=SUBSTITUA_POR_OUTRA_SENHA_FORTE
SCRAPE_HOSTS=www.confianca.com.br,tauste.com.br,www.tauste.com.br
SCRAPE_MAX_PAGES=200

# APENAS para a instalação privada com compose.yaml:
# Use COOKIE_SECURE=1 quando acessar a aplicação via HTTPS.
# Ajuste a rede Docker externa e o túnel conforme a infraestrutura particular.
CADDY_LAN_IP=192.168.1.240
CADDY_LAN_MAC=02:42:C0:A8:01:F0
CADDY_DATA_DIR=./web/docker/production/data/caddy/data
CADDY_CONFIG_DIR=./web/docker/production/data/caddy/config
DB_BIND_IP=127.0.0.1
DB_EXTERNAL_PORT=3308
TUNNEL_TOKEN=